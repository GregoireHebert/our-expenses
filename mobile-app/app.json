{
  "expo": {
    "name": "Our Expenses",
    "description": "Expenses repartition according to incomes",
    "slug": "our-expenses",
    "platforms": [
      "ios"
    ],
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#e9f6e9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.gheb.ourexpenses",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c8a859e6-f809-40d1-901d-6cd8370bf584"
      }
    },
    "owner": "gregoirehebert"
  }
}
