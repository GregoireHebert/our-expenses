{
  "expo": {
    "name": "Our Expenses",
    "description": "Expenses repartition according to incomes",
    "slug": "our-expenses",
    "platforms": [
      "ios"
    ],
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#e9f6e9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gheb.ourexpenses",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
