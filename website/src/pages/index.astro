---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";
import Receipt from "../components/Receipt.astro";
import { SITE, APP_STORE_URL } from "../config";

const chips = [
  { txt: "pizza", left: "calc(50% - 455px)", top: "6%", rot: "-10deg", bg: "#ffe6dd", fg: "#48160a", delay: "0s" },
  { txt: "rent", left: "calc(50% + 355px)", top: "3%", rot: "7deg", bg: "#d0f7f9", fg: "#003338", delay: "0.6s" },
  { txt: "wifi", left: "calc(50% - 440px)", top: "40%", rot: "-6deg", bg: "#ffe5f7", fg: "#411635", delay: "1.2s" },
  { txt: "uber", left: "calc(50% + 370px)", top: "44%", rot: "12deg", bg: "#e9ecff", fg: "#22224f", delay: "1.8s" },
  { txt: "groceries", left: "calc(50% - 480px)", top: "84%", rot: "6deg", bg: "#dff6de", fg: "#06320c", delay: "2.4s" },
  { txt: "beers \u{1F37A}", left: "calc(50% + 350px)", top: "86%", rot: "-8deg", bg: "#ffebd2", fg: "#3f2100", delay: "3s" },
];

const description =
  "Our Expenses splits what you share in proportion to what each of you earns. Everything stays on your iPhone.";
---

<Base title="Our Expenses" description={description}>
  <header class="hero">
      <div class="chips" aria-hidden="true">
        {
          chips.map((chip) => (
            <span
              class="chip"
              style={
                "left:" + chip.left +
                ";top:" + chip.top +
                ";--rot:" + chip.rot +
                ";animation-delay:" + chip.delay +
                ";background:" + chip.bg +
                ";color:" + chip.fg +
                ";transform:rotate(" + chip.rot + ")"
              }
            >
              {chip.txt}
            </span>
          ))
        }
      </div>

    <div class="shell hero__content">
        <Wordmark size="hero" />
        <p class="eyebrow hero__tagline">{SITE.tagline}</p>
        <p class="hero__lead">
          One of you earns more. A rent split down the middle takes a bigger bite
          out of the smaller salary. Our Expenses divides each shared cost in
          proportion to what each of you brings in.
        </p>
        <p class="hero__cta">
          {
            APP_STORE_URL ? (
              <a class="button" href={APP_STORE_URL}>
                Get it on the App Store
              </a>
            ) : (
              <span class="button button--pending">Coming to the App Store</span>
            )
          }
        </p>
    </div>
  </header>

  <div class="shell">
    <section>
      <h2>A receipt, not a lecture</h2>
      <div class="receipt-demo">
        <Receipt />
      </div>
    </section>

    <section>
      <h2>How it works</h2>
      <ul class="steps">
        <li class="step card">
          <h3>Add everyone once</h3>
          <p>
            Names and monthly incomes, up to ten people. They stay on your phone
            and come back for every expense you enter.
          </p>
        </li>
        <li class="step card">
          <h3>Type the amount</h3>
          <p>
            Enter what the groceries cost. Each share appears as a receipt, with
            the percentage next to the figure, so nobody takes the arithmetic on
            trust.
          </p>
        </li>
        <li class="step card">
          <h3>Keep the receipt</h3>
          <p>
            Save an expense and it joins your history with the split frozen as it
            stood. A raise next year leaves last month's receipt alone.
          </p>
        </li>
      </ul>
    </section>

    <section>
      <h2>Nothing leaves your phone</h2>
      <div class="card">
        <p style="margin:0;color:var(--ink-soft)">
          No account to create, no server to trust, no analytics, no ads. People,
          incomes and receipts sit in your device storage and go nowhere else.
          Delete the app and they go with it. See 
          <a href="/privacy" style="color:var(--accent)">&nbsp;privacy policy</a> for
          more informations.
        </p>
      </div>
    </section>
  </div>
</Base>
